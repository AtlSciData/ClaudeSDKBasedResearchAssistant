# Copy this file to .env and fill in your own values. Never commit .env --
# it's already in .gitignore.

AWS_REGION=us-east-1

# Cognito user pool used by POST /api/login and JWT verification
COGNITO_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: tells the Claude Agent SDK to route model calls through AWS
# Bedrock (using the AWS credentials already available to this process)
# instead of Anthropic's direct API. Without this, the SDK sends the
# Bedrock-formatted model ID below to the direct API instead, which fails
# with "model may not exist or you may not have access to it."
CLAUDE_CODE_USE_BEDROCK=1

# Model routed through AWS Bedrock. Defaults to this value in
# backend/app/agent_session.py if unset -- override to pin a different
# Bedrock inference profile.
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0