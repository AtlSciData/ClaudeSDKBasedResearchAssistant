# Copy this file to .env and fill in your own values. Never commit .env --
# it's already in .gitignore.

AWS_REGION=us-east-1

# Cognito user pool used by POST /api/login and JWT verification
COGNITO_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Model routed through AWS Bedrock. Defaults to this value in
# backend/app/agent_session.py if unset -- override to pin a different
# Bedrock inference profile.
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
